{
  "name": "@office-copilot/pdf-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "import": "./dist/pure.js",
      "default": "./src/pure.ts"
    },
    "./testing": {
      "types": "./dist/test-pdf.d.ts",
      "import": "./dist/test-pdf.js",
      "default": "./src/test-pdf.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@office-copilot/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
