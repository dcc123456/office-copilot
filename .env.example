# Copy to .env and fill in. .env is git-ignored.

# LLM provider (OpenAI-compatible endpoint). DeepSeek example:
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# Server
PORT=3001
# Comma-separated allowed origins for CORS (task-pane origin).
CORS_ORIGINS=https://localhost:5173
