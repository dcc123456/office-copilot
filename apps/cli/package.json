{
  "name": "@office-copilot/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "oc": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@office-copilot/docx-io": "workspace:*",
    "@office-copilot/pptx-io": "workspace:*",
    "@office-copilot/sheet-io": "workspace:*",
    "@office-copilot/shared": "workspace:*",
    "@office-copilot/word-tools": "workspace:*",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "picocolors": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
