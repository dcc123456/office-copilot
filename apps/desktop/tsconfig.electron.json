{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-electron",
    "rootDir": "electron",
    "types": ["node"],
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["electron/**/*"],
  "exclude": ["electron/**/*.test.ts", "electron/**/*.test.tsx"]
}
